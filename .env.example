# The diff parser works without a database or an AI provider.
# These settings will be used by later milestones.
DATABASE_URL=postgresql+asyncpg://review_app:review_app_dev_only@localhost:5435/review_platform
REDIS_URL=redis://localhost:6380/0

# GitLab integration (use a token with read_api / read_repository access)
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=replace_with_your_gitlab_access_token

# AI review provider (OpenAI-compatible Chat Completions API)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_your_ai_provider_key
AI_MODEL=gpt-4o-mini

# GitLab webhook secret: configure the same value in the GitLab project webhook.
GITLAB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Background review jobs (Redis is used for Celery broker and job status)
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
REVIEW_JOB_TTL_SECONDS=604800
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800
REVIEW_TASK_MAX_RETRIES=3
REVIEW_TASK_RETRY_DELAY_SECONDS=30
REVIEW_TASK_TIME_LIMIT_SECONDS=1800
REVIEW_TASK_SOFT_TIME_LIMIT_SECONDS=1500

# Repository Knowledge Engine (SQLite index; keep data/ out of source control)
KNOWLEDGE_DB_PATH=./data/repository_knowledge.sqlite3
KNOWLEDGE_MAX_FILE_BYTES=250000
KNOWLEDGE_MAX_FILES=5000
KNOWLEDGE_PROJECT_IDS=
REVIEW_RULES_DIR=./review-rules


# Centralized web + remote MCP access. Generate a long random value and
# configure the same value in remote Kiro MCP client Authorization headers.
# Never commit the real .env file or share this token publicly.
AGENT_ACCESS_TOKEN=replace_with_a_long_random_agent_access_token

# Milestone 17: administrator token for issuing/revoking individual developer tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_ADMIN_TOKEN=replace_with_a_separate_long_random_admin_token
AGENT_ACCESS_DB_PATH=./data/agent_access.sqlite3
